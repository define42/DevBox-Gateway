# syntax=docker/dockerfile:1
# Keep the C toolchain and libvirt headers in the target distribution: CGO must
# not inherit ABI requirements from the developer's machine or CI runner.
ARG GO_VERSION=1.27.1
FROM golang:${GO_VERSION}-bookworm AS go-toolchain

FROM node:22-bookworm-slim AS ui
WORKDIR /src
RUN npm install -g typescript@5.5.4
COPY ui ui
COPY tsconfig.json ./
RUN tsc -p tsconfig.json

FROM debian:bookworm-slim AS deb-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gcc libc6-dev pkg-config libvirt-dev dpkg-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" GOPATH=/go GOTOOLCHAIN=local CGO_ENABLED=1
WORKDIR /src
COPY go.mod go.sum ./
COPY SauronAgent/go.mod SauronAgent/go.sum SauronAgent/
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd cmd
COPY internal internal
COPY SauronAgent/collector SauronAgent/collector
COPY SauronAgent/internal SauronAgent/internal
COPY --from=ui /src/internal/webassets/dashboard.js internal/webassets/dashboard.js
COPY devbox-gateway.service devbox-gateway.conf LICENSE ./
ARG VERSION=0.0.0
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,id=devbox-deb-go-build,target=/root/.cache/go-build \
    mkdir -p /out && go build -o /build/devbox-gateway ./cmd/devbox-gateway \
    && go run ./cmd/mkdeb -binary /build/devbox-gateway -version "${VERSION}" \
        -out "/out/devbox-gateway_${VERSION}_amd64.deb"

FROM debian:bookworm-slim AS deb-check
COPY --from=deb-build /out/ /packages/
COPY packaging/check-native.sh /check-native.sh
RUN apt-get update && apt-get install -y --no-install-recommends /packages/*.deb \
    && sh /check-native.sh /usr/bin/devbox-gateway \
    && dpkg-deb --field /packages/*.deb Depends > /tmp/package-dependencies \
    && cat /tmp/package-dependencies \
    && grep -E 'libvirt0 \(>= [0-9]' /tmp/package-dependencies \
    && grep -E 'libc6 \(>= [0-9]' /tmp/package-dependencies

FROM scratch AS deb
COPY --from=deb-check /packages/ /

FROM rockylinux:9 AS rpm-build
# libvirt's development headers live in CRB; runtime packages use normal repos.
RUN dnf install -y --enablerepo=crb --setopt=install_weak_deps=False \
    ca-certificates gcc glibc-devel pkgconf-pkg-config libvirt-devel rpm-build \
    && dnf clean all
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" GOPATH=/go GOTOOLCHAIN=local CGO_ENABLED=1
WORKDIR /src
COPY go.mod go.sum ./
COPY SauronAgent/go.mod SauronAgent/go.sum SauronAgent/
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd cmd
COPY internal internal
COPY SauronAgent/collector SauronAgent/collector
COPY SauronAgent/internal SauronAgent/internal
COPY --from=ui /src/internal/webassets/dashboard.js internal/webassets/dashboard.js
COPY devbox-gateway.service devbox-gateway.conf LICENSE ./
ARG VERSION=0.0.0
ARG RELEASE=1
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,id=devbox-rpm-go-build,target=/root/.cache/go-build \
    mkdir -p /out && go build -o /build/devbox-gateway ./cmd/devbox-gateway \
    && go run ./cmd/mkrpm -binary /build/devbox-gateway -version "${VERSION}" \
        -release "${RELEASE}" -out "/out/devbox-gateway-${VERSION}-${RELEASE}.x86_64.rpm"

FROM rockylinux:9 AS rpm-check
COPY --from=rpm-build /out/ /packages/
COPY packaging/check-native.sh /check-native.sh
RUN dnf install -y --setopt=install_weak_deps=False /packages/*.rpm \
    && sh /check-native.sh /usr/bin/devbox-gateway \
    && rpm -qp --requires /packages/*.rpm > /tmp/package-dependencies \
    && cat /tmp/package-dependencies \
    && grep -F 'libvirt.so.0(LIBVIRT_' /tmp/package-dependencies \
    && grep -F 'libc.so.6(GLIBC_' /tmp/package-dependencies

FROM scratch AS rpm
COPY --from=rpm-check /packages/ /
