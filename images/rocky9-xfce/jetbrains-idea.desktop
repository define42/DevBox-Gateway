[Desktop Entry]
Version=1.0
Type=Application
Name=IntelliJ IDEA
GenericName=Integrated Development Environment
Comment=Develop Java, Kotlin, and other applications
Exec=/opt/intellij-idea/bin/idea %f
TryExec=/opt/intellij-idea/bin/idea
Icon=/opt/intellij-idea/bin/idea.svg
Terminal=false
Categories=Development;IDE;
StartupNotify=true
StartupWMClass=jetbrains-idea
