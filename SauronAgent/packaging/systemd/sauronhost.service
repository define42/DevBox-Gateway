# SauronHost -- hypervisor-side collector.
#
# This unit runs on the KVM host, not inside a VM. It is the mirror image of
# sauronagent.service and the differences are all consequences of one fact:
# the collector does not read the audit subsystem, so it needs no capability
# whatsoever. What it does need is the VSOCK listener and somewhere to write.

[Unit]
Description=SauronHost audit collector for guest VMs
Documentation=https://github.com/define42/SauronAgent
Documentation=file:/usr/share/doc/sauronagent/deployment.md

# vhost_vsock must be loaded for guests to reach VMADDR_CID_HOST. Loading it
# is the hypervisor's job (modules-load.d, or libvirt/QEMU pulling it in when
# a VM with a vsock device starts); the listener itself only needs the AF_VSOCK
# socket family, so this unit does not depend on any VM being up.
After=local-fs.target
Wants=local-fs.target

# A collector systemd has stopped restarting is a hypervisor whose guests are
# all silently unmonitored, so the start rate limit is disabled here for the
# same reason as in the agent unit.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/sauronhost -config /etc/sauronhost/sauronhost.yaml

Restart=always
RestartSec=5s

User=sauronhost
Group=sauronhost

# --- capabilities -----------------------------------------------------------
#
# Empty bounding set: no capability, not even a bounded one. The collector
# parses frames sent by guests that must be assumed hostile, so the process
# that does that parsing is given nothing to escalate with.
#
# The one capability an operator might reach for is CAP_NET_BIND_SERVICE, and
# only if listen.port is moved below 1024. Keep it at 9000 instead.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true

# --- filesystem -------------------------------------------------------------
#
# LogsDirectory is the collector's equivalent of the agent's StateDirectory:
# with ProtectSystem=strict the filesystem is read-only, and this is what makes
# /var/log/sauronhost writable and owned by User=. It matches the default
# output.file.path; change both together or the file sink fails with EROFS.
LogsDirectory=sauronhost
LogsDirectoryMode=0750

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateMounts=true
UMask=0027

# Events written here carry the command lines and file paths of every audited
# guest -- a more sensitive collection than any single guest's spool. 0750
# rather than 0700 so that a log-shipping account added to the sauronhost
# group can read the file without being given the ability to write it.

# --- kernel and device surface ---------------------------------------------
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Same reasoning as the agent: the AF_VSOCK listener is a socket, not a device
# node. /dev/vsock is only needed to query the local context ID, which the
# collector never does -- it binds VMADDR_CID_ANY and reads each peer's CID
# from the accepted connection.
PrivateDevices=true

# Unlike the agent, the collector reads nothing from /proc, so /proc can be
# reduced to process directories. (os.Hostname() uses uname(2); it only falls
# back to /proc/sys/kernel/hostname for names of 64 characters or more, and
# host.name should be set explicitly in the configuration anyway.)
ProtectProc=invisible
ProcSubset=pid

# --- process and memory -----------------------------------------------------
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
KeyringMode=private

# --- sockets ----------------------------------------------------------------
#
# AF_VSOCK -- the listener. Omitting it makes bind() fail with EAFNOSUPPORT,
#             which reads like a missing vhost_vsock module on the hypervisor;
#             check this line before going looking for one.
# AF_UNIX  -- the journal, and the local syslog socket when output.syslog is
#             enabled with network: "".
#
# AF_NETLINK is absent on purpose: the collector has no audit source of its
# own. AF_INET/AF_INET6 are absent too, so add them here (and relax
# IPAddressDeny) only if you configure output.syslog with network: tcp or udp,
# or listen.kind: tcp for development.
RestrictAddressFamilies=AF_VSOCK AF_UNIX

# The collector's whole point is that guest telemetry reaches the host without
# touching IP. Denying IP here means a compromised collector cannot forward
# what it has collected anywhere on its own.
IPAddressDeny=any

# --- system calls -----------------------------------------------------------
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native

# One listening socket plus one connection per guest, bounded by
# limits.max_connections (1024 by default), plus rotated output files.
LimitNOFILE=8192

# The collector holds every guest's stream. Losing it to the OOM killer while
# a VM is being attacked is the failure this whole system exists to prevent.
OOMScoreAdjust=-500

# --- verifying this unit ----------------------------------------------------
#
#   systemd-analyze security --offline=true sauronhost.service
#
# scores this unit at exposure level 1.0 ("OK"). What it still flags is
# deliberate: AF_UNIX and AF_VSOCK ("exotic"), PrivateNetwork, PrivateUsers,
# and UMask=0027, which exists so a log shipper in the sauronhost group can
# read the events.

[Install]
WantedBy=multi-user.target
